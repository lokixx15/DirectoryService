# GitHub NuGet registry credentials (classic PAT with read:packages scope)
NUGET_USERNAME=
NUGET_PASSWORD=

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# PostgreSQL connection string for DirectoryService (used by migrations bundle)
DIRECTORY_SERVICE_CONNECTION=Host=postgres;Port=5432;Database=directory_service_db;Username=postgres;Password=postgres
FILE_SERVICE_CONNECTION=Host=postgres;Port=5432;Database=file_service_db;Username=postgres;Password=postgres